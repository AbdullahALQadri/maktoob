<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Maktoob</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Maktoob</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- Camera (QR scanner) -->
		<key>NSCameraUsageDescription</key>
		<string>يحتاج التطبيق إلى الوصول إلى الكاميرا لمسح رموز QR للضيوف</string>
		<!-- Contacts (guest import from address book) -->
		<key>NSContactsUsageDescription</key>
		<string>يحتاج التطبيق إلى الوصول إلى جهات الاتصال لدعوة الأصدقاء والعائلة</string>
		<!-- Photo Library (invitation cover + payment receipts) -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>يحتاج التطبيق إلى الوصول إلى مكتبة الصور لاختيار صور الدعوة وإيصالات الدفع</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>يحتاج التطبيق إلى إذن لحفظ الدعوة في مكتبة الصور</string>
		<!-- Push notifications (FCM) delivered while the app is in the background;
		     fetch / processing: uploading door check-ins and queued writes made
		     offline (workmanager, BackgroundSync in lib/core/offline). -->
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
			<string>fetch</string>
			<string>processing</string>
		</array>
		<key>BGTaskSchedulerPermittedIdentifiers</key>
		<array>
			<string>com.maktoob.maktoob.offlineSync</string>
		</array>
		<!-- Venue hub: the door phones talk to each other over the hall's Wi-Fi
		     or a hotspot, with no internet (iOS asks the user once). -->
		<key>NSLocalNetworkUsageDescription</key>
		<string>يتصل التطبيق بأجهزة البوابات الأخرى في القاعة عبر الشبكة المحلية لمزامنة تسجيلات الدخول بدون إنترنت</string>
		<!-- url_launcher canLaunchUrl() for the WhatsApp deep link -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>whatsapp</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
